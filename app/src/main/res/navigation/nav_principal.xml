<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_principal"
    app:startDestination="@id/bienvenidaFragment">

    <!-- Pantalla de bienvenida: es la primera que se muestra -->
    <fragment
        android:id="@+id/bienvenidaFragment"
        android:name="com.karen.nova.ui.bienvenida.BienvenidaFragment"
        android:label="Bienvenida"
        tools:layout="@layout/fragment_bienvenida">

        <!-- Flecha: "Comenzar". Borra la bienvenida del historial -->
        <action
            android:id="@+id/accion_bienvenida_a_inicioSesion"
            app:destination="@id/inicioSesionFragment"
            app:popUpTo="@id/nav_principal"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Pantalla de inicio de sesión: -->
    <fragment
        android:id="@+id/inicioSesionFragment"
        android:name="com.karen.nova.ui.autenticacion.InicioSesionFragment"
        android:label="Iniciar sesión"
        tools:layout="@layout/fragment_inicio_sesion">

        <!-- Flecha: "¿No tienes cuenta? Regístrate" -->
        <action
            android:id="@+id/accion_inicioSesion_a_registro"
            app:destination="@id/registroFragment" />

        <!-- Flecha: "Ingresar". Borra el login del historial -->
        <action
            android:id="@+id/accion_inicioSesion_a_lista"
            app:destination="@id/listaGastosFragment"
            app:popUpTo="@id/nav_principal"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Pantalla de registro -->
    <fragment
        android:id="@+id/registroFragment"
        android:name="com.karen.nova.ui.autenticacion.RegistroFragment"
        android:label="Registro"
        tools:layout="@layout/fragment_registro" />

    <!-- Pantalla de la lista de gastos -->
    <fragment
        android:id="@+id/listaGastosFragment"
        android:name="com.karen.nova.ui.lista.ListaGastosFragment"
        android:label="Mis gastos"
        tools:layout="@layout/fragment_lista_gastos">

        <!-- Flecha: "Salir". Borra la lista del historial -->
        <action
            android:id="@+id/accion_lista_a_inicioSesion"
            app:destination="@id/inicioSesionFragment"
            app:popUpTo="@id/nav_principal"
            app:popUpToInclusive="true" />
        <!-- Flecha: botón + → formulario -->
        <action
            android:id="@+id/accion_lista_a_formulario"
            app:destination="@id/formularioGastoFragment" />
    </fragment>

    <!-- Flecha: tocar un gasto → detalle -->
    <action
        android:id="@+id/accion_lista_a_detalle"
        app:destination="@id/detalleGastoFragment" />

    <!-- Pantalla del formulario de gasto (crear o editar) -->
    <fragment
        android:id="@+id/formularioGastoFragment"
        android:name="com.karen.nova.ui.formulario.FormularioGastoFragment"
        android:label="Formulario"
        tools:layout="@layout/fragment_formulario_gasto">

        <!-- -1 = crear un gasto nuevo; otro número = editar ese gasto -->
        <argument
            android:name="gastoId"
            android:defaultValue="-1L"
            app:argType="long" />
    </fragment>

    <!-- Pantalla de detalle de un gasto -->
    <fragment
        android:id="@+id/detalleGastoFragment"
        android:name="com.karen.nova.ui.detalle.DetalleGastoFragment"
        android:label="Detalle"
        tools:layout="@layout/fragment_detalle_gasto">

        <!-- Dato que recibe esta pantalla: el id del gasto -->
        <argument
            android:name="gastoId"
            app:argType="long" />

        <!-- Flecha: botón Editar → formulario -->
        <action
            android:id="@+id/accion_detalle_a_formulario"
            app:destination="@id/formularioGastoFragment" />

    </fragment>

</navigation>