<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_nova"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="32dp">

        <!-- Ícono de Nova dentro de un círculo lila -->
        <ImageView
            android:id="@+id/imagen_logo"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="56dp"
            android:background="@drawable/fondo_circulo"
            android:contentDescription="Logo de Nova"
            android:padding="28dp"
            android:src="@drawable/ic_billetera"
            app:tint="@color/morado_principal" />

        <!-- Título -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:text="Te damos la bienvenida a Nova"
            android:textColor="@color/morado_principal"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- Descripción -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Tu espacio para llevar el control de tus gastos personales de forma fácil."
            android:textColor="@color/texto_nova"
            android:textSize="16sp" />

        <!-- Tarjeta con lo que se puede hacer en la app -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/morado_suave"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="✓  Registra tus gastos en segundos"
                    android:textColor="@color/texto_nova"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="✓  Revisa cuánto llevas gastado en el mes"
                    android:textColor="@color/texto_nova"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="✓  Edita, comparte o elimina tus gastos cuando quieras"
                    android:textColor="@color/texto_nova"
                    android:textSize="15sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Botón para continuar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/boton_comenzar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="40dp"
            android:backgroundTint="@color/morado_principal"
            android:text="Comenzar"
            android:textSize="16sp"
            app:cornerRadius="12dp" />

    </LinearLayout>
</ScrollView>